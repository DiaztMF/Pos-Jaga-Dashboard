# Firebase Realtime Database config for the Pos Jaga dashboard.
# Copy to .env and fill with values from Firebase Console > Project settings.
VITE_FIREBASE_DATABASE_URL=https://voxsilva-forest-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_API_KEY=AIzaSyD-ExampleKeyReplaceWithYourOwn0000000

# Monitoring baterai node. Biarkan "off" selama BATTERY_ADC_ENABLED di
# node_hutan.ino masih dikomentari: firmware mengirim konstanta 3.8 V, bukan
# hasil pengukuran, dan menampilkannya berarti memasang telemetri palsu.
# Setel "on" setelah divider terpasang dan ambang di src/stats.js disesuaikan
# dengan kimia pack yang dipakai.
VITE_BATTERY_MONITORING=off
